# Copy to `.env` and adjust. All values are optional.

# Bootstrapped on first run so you can call the API right away.
SPIREFLOW_BOOTSTRAP_KEY=sk-spireflow-dev-local-key

# Model to load (phonon-2.5, phonon-2.5-en, phonon-2, phonon-1, or a repo id).
SPIREFLOW_MODEL=phonon-2.5

# Extra model ids accepted by /v1/models (comma separated). "whisper-1" lets
# OpenAI SDKs that hard-code the model name work unchanged.
SPIREFLOW_MODELS=whisper-1

# Require `Authorization: Bearer <key>` on /v1 routes.
SPIREFLOW_REQUIRE_AUTH=true

# Where the SQLite database lives.
SPIREFLOW_DB=data/spireflow.db

# Upload cap per request.
SPIREFLOW_MAX_UPLOAD_MB=100

# Comma separated CORS origins.
SPIREFLOW_CORS_ORIGINS=*

# Log every request (and token/audio usage) to SQLite.
SPIREFLOW_LOG_REQUESTS=true

# Set to false to skip loading the model at startup (used by tests).
SPIREFLOW_LOAD_MODEL=true
